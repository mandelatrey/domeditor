{
  "name": "domeditor",
  "version": "0.2.1",
  "description": "A development-only visual editor: point at the page, adjust type, spacing and copy, save the change into the file it came from. For Vite and Next.js.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandelatrey/domeditor.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/core/server.d.ts",
      "default": "./dist/core/server.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/route": {
      "types": "./dist/next/route.d.ts",
      "default": "./dist/next/route.js"
    },
    "./next/config": {
      "types": "./dist/next/config.d.ts",
      "default": "./dist/next/config.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:css && tsup",
    "typecheck": "npm run build:css && tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "postcss": "^8.5.33"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
